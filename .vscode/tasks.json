{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build (Debug)",
      "detail": "dotnet build Skins/Skins.csproj",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Skins/Skins.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "build (Release)",
      "detail": "dotnet build Skins/Skins.csproj -c Release",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Skins/Skins.csproj",
        "-c",
        "Release",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "clean",
      "detail": "dotnet clean Skins/Skins.csproj",
      "type": "process",
      "command": "dotnet",
      "args": [
        "clean",
        "${workspaceFolder}/Skins/Skins.csproj"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}